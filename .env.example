# Supabase Configuration
# These are provided by your Supabase project
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Printavo API Credentials
# IMPORTANT: These should NOT be set in the .env file!
# Configure these as secrets in your Supabase Edge Function environment:
#
# 1. Go to your Supabase dashboard
# 2. Navigate to Edge Functions → printavo-proxy
# 3. Add these as environment variables/secrets:
#    - PRINTAVO_EMAIL: your-printavo-email@example.com
#    - PRINTAVO_TOKEN: your-printavo-api-token
#
# These credentials are NEVER exposed to the frontend for security.
